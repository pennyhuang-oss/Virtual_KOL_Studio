        "test": "全身比例",
        "spec": "full_body 站姿，adequate DOF——驗身材沒有被放大成豐滿"
      },
      {
        "id": "st05",
        "test": "坐姿",
        "spec": "seated waist_up，驗坐下時軀幹比例是否穩定"
      },
      {
        "id": "st06",
        "test": "戶外散射光",
        "spec": "陰天街上 knee_up——訓練集沒有強戶外光"
      },
      {
        "id": "st07",
        "test": "夜間混光",
        "spec": "夜間街邊招牌光 waist_up——測色偏下的膚色穩定度"
      },
      {
        "id": "st08",
        "test": "C 級醜光線",
        "spec": "超商冷白日光燈頂光 waist_up——最容易讓臉崩的條件"
      },
      {
        "id": "st09",
        "test": "換髮型",
        "spec": "完全不同髮型（長髮接髮或高馬尾），驗 identity 是否綁在短鮑伯上"
      },
      {
        "id": "st10",
